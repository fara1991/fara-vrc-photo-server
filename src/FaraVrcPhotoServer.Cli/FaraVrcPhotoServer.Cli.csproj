<Project Sdk="Microsoft.NET.Sdk">

  <!-- 手元で動かす確認用の CLI（ログを読んで履歴に書く・履歴を見る）。常駐ソフト本体は E3 で別に作る -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FaraVrcPhotoServer.Cli</RootNamespace>
    <AssemblyName>vrcserver</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FaraVrcPhotoServer.Core\FaraVrcPhotoServer.Core.csproj" />
  </ItemGroup>

</Project>
